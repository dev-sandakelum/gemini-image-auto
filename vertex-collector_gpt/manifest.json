{
  "manifest_version": 3,
  "name": "Vertex Image Collector — GPT",
  "version": "2.0",
  "description": "Tracks product image slots, copies prompts, and saves ChatGPT-generated images with pipeline-correct filenames. You generate; it organizes.",
  "permissions": ["storage", "downloads", "clipboardWrite"],
  "host_permissions": ["https://chatgpt.com/*", "https://*.oaiusercontent.com/*", "http://127.0.0.1:7843/*"],
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Vertex Image Collector"
  },
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    {
      "resources": ["brand/*"],
      "matches": ["https://chatgpt.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
